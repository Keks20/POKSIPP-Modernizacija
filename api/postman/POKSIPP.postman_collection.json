      "item": [
        {
          "name": "Prijava - admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/prijava",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "prijava"
              ]
            },
            "description": "Čuva token u promenljivu kolekcije {{token}}; svi ostali pozivi ga koriste.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"korisnicko_ime\": \"admin\",\n  \"lozinka\": \"admin123\",\n  \"uredjaj\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Prijava uspela', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('token', j.token); }",
                  "pm.test('Uloga je vraćena', () => pm.expect(j.uloga).to.be.a('string'));"
                ]
              }
            }
          ]
        },
